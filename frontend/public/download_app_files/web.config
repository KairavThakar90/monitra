<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the installer folder ONLY.

  Vite copies `public/` verbatim into the build, so this file is deployed with
  the website at /download_app_files/web.config and IIS reads it as that
  folder's configuration. It is deliberately scoped to this directory: it adds
  nothing to the site root, so whatever URL-rewrite or other configuration the
  site itself carries on the server is untouched.

  Why it exists (2026-10-27): IIS serves a static file only when its extension
  has a MIME type. `.exe` has one by default; `.dmg` does not, so both macOS
  installers answered an HTML "404 Not Found" page while the files sat in the
  folder. The download buttons and every macOS update failed on that.

  `remove` before `mimeMap`: if the server already maps `.dmg` at a higher
  level, adding it again is a duplicate-key configuration error (an HTTP 500
  for the whole folder). Removing first makes this safe either way.

  Prove it after a deploy:
    python desktop/tools/verify_download_urls.py \
      --base-url https://staff.peakworkos.com/download_app_files/ --version <v> --artifacts <ci outputs>
  must print three OK lines (the .dmg answers must be 200 with
  Content-Type application/x-apple-diskimage, never text/html).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".dmg" />
      <mimeMap fileExtension=".dmg" mimeType="application/x-apple-diskimage" />
      <remove fileExtension=".sha256" />
      <mimeMap fileExtension=".sha256" mimeType="text/plain" />
    </staticContent>
  </system.webServer>
</configuration>
