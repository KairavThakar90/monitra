# Environment files
.env
*.env
**/.env.backup
!.env.example

# Google service account credentials. The screenshot module reads these from
# the environment (GOOGLE_SERVICE_ACCOUNT_JSON) or from a key file on disk
# (GOOGLE_SERVICE_ACCOUNT_JSON_PATH); a committed private key is a credential
# leak that no later commit can undo.
secrets/
**/service-account*.json
**/google-service-account*.json
*-service-account.json

# Python
__pycache__/
*.pyc
venv/
.venv/   

# Node (backup in case frontend's own .gitignore is ever missing)
node_modules/

# OS/editor junk
.DS_Store
.vscode/  
.vercel
.env*
# This second `.env*` pattern (above) was defeating the `!.env.example`
# negation at the top of this file, so a new placeholders-only example could
# not be committed while `desktop/.env.example` -- added before it -- stayed
# tracked. Re-asserted here, after the pattern that overrode it. Only the
# literal name `.env.example` is exempt; every real `.env` stays ignored.
!**/.env.example

# local dev server logs
*.log
