# Monitra backend — environment variables.
#
# PLACEHOLDERS ONLY. Copy to `.env` for local development, or set these as
# platform environment variables in production (Vercel: Project → Settings →
# Environment Variables). Never commit a real value from this file.
#
# Only the transactional-email settings are documented here; the database,
# authentication-provider and Google Drive settings this backend also reads are
# described in backend/VERCEL_DEPLOYMENT.md and app/core/config.py.

# ─────────────────────────────────────────────────────────────────────────
# Database connection pool (per Uvicorn worker) — see docs/DB_CONNECTION_LIFECYCLE.md
# ─────────────────────────────────────────────────────────────────────────
# Most connections one deployment opens = workers x (POOL_SIZE + MAX_OVERFLOW).
# The defaults (10 + 5, 10 s wait) are for the VM; a serverless deployment should
# use smaller values because every instance has its own pool.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=1800
# Log a connection held longer than this many seconds (0 = off).
# DB_CHECKOUT_WARN_SECONDS=5
# PostgreSQL's backstop for a session idle inside a transaction, in milliseconds.
# Leave unset until the application fix is deployed and verified.
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# ─────────────────────────────────────────────────────────────────────────
# Transactional email — transport
# ─────────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER selects how mail leaves the system:
#   smtp      a real mail server, configured below. Use this in production.
#   console   logs the envelope instead of sending. Local development only.
#   disabled  queue but never deliver; rows stay pending.
# Anything unrecognised is treated as `disabled` rather than guessed at.
EMAIL_PROVIDER=smtp

# The envelope sender. Required — with it unset, nothing is delivered and every
# notification stays queued. Use an address on a domain whose SPF/DKIM/DMARC
# records authorise your provider, or the mail will be filed as spam.
EMAIL_FROM_ADDRESS=monitra@example.com
EMAIL_FROM_NAME=Monitra
# Optional. Where a human reply should go; omitted from the message when empty.
EMAIL_REPLY_TO=

# SMTP. Every transactional provider (Amazon SES, SendGrid, Postmark, Mailgun,
# Brevo, Resend, Google Workspace) offers an SMTP endpoint, so no provider SDK
# is needed — point these at whichever you use.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on the submission port (587). Leave true.
SMTP_USE_TLS=true
# Implicit TLS (SMTPS, port 465). Set this instead of SMTP_USE_TLS if your
# provider requires it; do not set both.
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# ─────────────────────────────────────────────────────────────────────────
# Feedback notifications — recipients
# ─────────────────────────────────────────────────────────────────────────
# Who is told when somebody submits feedback from the Monitra desktop client.
# No address is hard-coded anywhere in the source. With none of these set,
# feedback is still saved and simply nobody is notified — the /health endpoint
# reports that state so it is noticeable.
FEEDBACK_ADMIN_EMAIL=admin@example.com
FEEDBACK_HR_EMAIL=hr@example.com
# Optional. Comma-separated, for any further recipients. Merged with the two
# above and de-duplicated, so the same address twice still receives one email.
FEEDBACK_NOTIFICATION_EMAILS=

# ─────────────────────────────────────────────────────────────────────────
# Welcome email
# ─────────────────────────────────────────────────────────────────────────
# Sent once, when a Monitra account is first provisioned. Turning this off
# stops new welcomes being queued; it does not affect the once-per-user
# guarantee, which is a unique constraint in the database.
WELCOME_EMAIL_ENABLED=true
# The welcome email's "Open Monitra" button. Rendered ONLY when this is a real
# https:// URL — an http:// or localhost value is ignored rather than mailed
# out as a broken button. Leave empty to send the email without a button.
MONITRA_APP_URL=
# Optional. Shown as "need a hand? write to ..." in both emails.
MONITRA_SUPPORT_EMAIL=

# ─────────────────────────────────────────────────────────────────────────
# Release announcement
# ─────────────────────────────────────────────────────────────────────────
# Publishing a desktop release emails every active user: the version, the
# release notes exactly as written, and a "Download the update" button
# pointing at MONITRA_APP_URL/download. Sent once per user per *version* --
# one version is several artifacts (Windows, macOS arm64, macOS x86_64), and
# publishing the second one sends nothing.
#
# OFF by default, and it stays off until a release has been verified: the mail
# goes to every eligible user and cannot be unsent. Nothing is announced until
# EVERY required platform artifact (DESKTOP_REQUIRED_ARTIFACTS) is published.
# As with the welcome email, the once-per-user guarantee is a unique
# constraint in the database and does not depend on this flag.
RELEASE_EMAIL_ENABLED=false
# Test mode: while this is set, the announcement goes ONLY to these addresses
# (comma-separated), tagged [TEST], and to no user. Empty = the real audience.
RELEASE_EMAIL_TEST_RECIPIENTS=

# Where release artifacts may be hosted (exact hostnames, https only), and an
# optional https prefix list that pins downloads to one releases repository.
DESKTOP_DOWNLOAD_ALLOWED_HOSTS=github.com
DESKTOP_DOWNLOAD_URL_PREFIXES=
# A version needs all of these registered and valid before any row may be
# published (platform or platform:architecture).
DESKTOP_REQUIRED_ARTIFACTS=win32,darwin:arm64,darwin:x86_64
# Refuse to publish a build whose registration says it is unsigned.
DESKTOP_REQUIRE_SIGNED_RELEASES=true
# Clients older than this are told an update exists and given the download link,
# but are not offered an in-app install: their updater (1.3.1 and earlier) has a
# Windows helper that does not reliably wait for Monitra to exit, so it can
# leave the installer unstarted and the app closed. Set to the first release that
# carries the fixed updater; empty disables the floor.
DESKTOP_AUTO_UPDATE_MIN_CLIENT_VERSION=1.3.2

# ─────────────────────────────────────────────────────────────────────────
# Weekly productivity report
# ─────────────────────────────────────────────────────────────────────────
# Every Monday morning each active user is emailed their own summary of the
# PREVIOUS COMPLETED week: tracked time, active and idle time, activity and
# project count, plus a button onto the Reports page filtered to that week.
# Queued by a scheduled call to /internal/reports/weekly/run and delivered by
# the same outbox, retry and dedupe machinery as every other Monitra email.
#
# Turning this off stops new reports being queued. As with the other flags
# here, the once-per-user-per-week guarantee does not depend on it: that is a
# unique constraint in the database, keyed on the week.
WEEKLY_REPORT_ENABLED=true

# The calendar the report week is cut on. Defaults to the timezone the rest of
# Monitra already reports in, so the email and the dashboard agree about which
# week is which. Stored timestamps stay UTC regardless; this moves only the
# Monday/Sunday boundary.
WEEKLY_REPORT_TIMEZONE=Asia/Kolkata

# When the run is meant to happen, in WEEKLY_REPORT_TIMEZONE. These do NOT
# schedule anything on their own — a serverless deployment has no resident
# process to hold a timer, so the actual trigger is the "crons" entry in
# vercel.json. They are the single source that entry is derived from:
# `weekly_cron_expression()` converts them to the UTC cron line, and a test
# asserts vercel.json still matches. Change these and you must redeploy the
# cron entry with them — the test will tell you if you forget.
#   monday 09:00 Asia/Kolkata  ->  "30 3 * * 1"
WEEKLY_REPORT_DAY=monday
WEEKLY_REPORT_HOUR=9
WEEKLY_REPORT_MINUTE=0

# "Your Monitra Monthly Report": queued for every eligible user on the 1st of
# each month by /internal/reports/monthly/run, covering the PREVIOUS COMPLETED
# month — total tracked time, average activity, projects, total working days,
# average per working day and the most productive day. Same outbox, retry and
# dedupe machinery as the weekly report; the period is cut on
# WEEKLY_REPORT_TIMEZONE. The send time is the 1st at MONTHLY_REPORT_HOUR:
# MONTHLY_REPORT_MINUTE local, and `monthly_cron_expression()` derives the
# vercel.json entry from it (a test asserts they match).
#   1st 09:00 Asia/Kolkata  ->  "30 3 1 * *"
MONTHLY_REPORT_ENABLED=true
MONTHLY_REPORT_HOUR=9
MONTHLY_REPORT_MINUTE=0

# "Monitra Monthly Project Summary": on the 1st of each month, administrators
# and owners (users with the can-own-projects flag) receive a company-wide
# summary of every project worked on in the previous month; leaders receive
# the same summary limited to the projects they lead or work on. Queued by
# /internal/reports/monthly-projects/run through the same outbox, retry and
# dedupe machinery. It shares WEEKLY_REPORT_TIMEZONE and
# MONTHLY_REPORT_HOUR/MINUTE, so it fires from the same "30 3 1 * *" cron.
# See docs/Monthly_Project_Summary.md.
MONTHLY_PROJECT_SUMMARY_ENABLED=true

# Fixed-hours budget alerts: admins, owners and the project's leaders are
# emailed once per project budget when Remaining reaches 50%, 20% and 10% of
# the allocation, and when Used reaches the allocation (100% consumed / over
# budget). Internal hours never count against the allocation. Evaluated after
# timer stops and manual approvals, and every five minutes by
# /internal/project-budget-alerts/run (vercel.json, "*/5 * * * *").
# See docs/Project_Budget_Alerts.md.
PROJECT_BUDGET_ALERTS_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────
# Delivery mechanics
# ─────────────────────────────────────────────────────────────────────────
# Attempts before a notification is parked as failed, and the retry backoff
# (exponential, jittered, capped). Six attempts span roughly six hours.
EMAIL_MAX_ATTEMPTS=6
EMAIL_RETRY_BASE_DELAY_SECONDS=60
EMAIL_RETRY_MAX_DELAY_SECONDS=3600
#
# EMAIL_DISPATCH_BATCH_SIZE is the *throughput knob*, and it matters most on a
# Monday: the weekly run queues one notification per user at once, and the
# sweeper drains at most this many per invocation. With the 5-minute schedule
# in vercel.json that is 12 x BATCH per hour — 240/hour at the default, which
# clears a 200-person organisation inside the first hour. Past roughly 250
# users, raise this rather than the cron frequency, and keep it low enough
# that one sweep still finishes inside the function's timeout (each send is a
# round trip to the mail server).
EMAIL_DISPATCH_BATCH_SIZE=20

# REQUIRED IN PRODUCTION. The shared secret for POST /internal/email/dispatch,
# which is the scheduled job that drains the outbox and retries failures. With
# this unset the endpoint answers 503, and the only delivery attempt a
# notification ever gets is the best-effort one inside the originating request
# — which a serverless platform may freeze before it runs.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
EMAIL_DISPATCH_TOKEN=

# Optional. A public https:// prefix the email templates load their logos from;
# this backend serves them at /email-assets. Left empty (the default), the
# logos are attached to each message and referenced by Content-ID instead,
# which needs no hosting and renders even when the client blocks remote images.
# Never point this at localhost — the recipient's mail client resolves it, not
# this server, and a localhost value is refused at render time.
EMAIL_ASSET_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────
# WFPM integration — Monitra → WFPM timer start and stop
# ─────────────────────────────────────────────────────────────────────────
# When a timer starts or stops on a task that is linked to WFPM
# (tasks.wfpm_task_id), this backend calls WFPM so the matching timer starts
# or stops there. The contract is
# docs/WFPM_INTEGRATION.md; the code is backend/app/WFPM.
#
# The full URL of WFPM's timer-start endpoint. LEFT EMPTY, THE INTEGRATION IS
# OFF: no event is queued and nothing is sent, and timers behave exactly as
# they always have. Never set a placeholder here — events queued against a URL
# that does not exist are all delivered, late, the day it does.
# If WFPM authorises by a key in the URL (https://…/timer?key=…), put the whole
# URL here. That makes this value a SECRET: Monitra never logs or stores the
# query string (it is redacted), so do not paste it anywhere either.
WFPM_TIMER_START_URL=
# The full URL of WFPM's timer-STOP endpoint, with its own ?key=… (a secret,
# like the start URL). LEFT EMPTY, STOPS ARE NOT ANNOUNCED. Independent of the
# start URL.
WFPM_TIMER_STOP_URL=
# The secret WFPM issues to this backend, sent as `Authorization: Bearer`.
# Leave it EMPTY (nothing after the =) when WFPM authorises by the key in the
# URL above, or by network. Never type placeholder text here: whatever follows
# the = is sent as the bearer token.
WFPM_API_TOKEN=
# How long one delivery attempt may take. Delivery happens after the timer
# start has been answered, so this never delays a user.
WFPM_REQUEST_TIMEOUT_SECONDS=10
# Attempts before a timer event is parked as failed, and the retry backoff
# (exponential, jittered, capped). Retries are driven by the scheduled call to
# /internal/wfpm/timer-events/dispatch (every minute; authenticated with
# EMAIL_DISPATCH_TOKEN like every other scheduled job).
WFPM_TIMER_MAX_ATTEMPTS=6
WFPM_TIMER_RETRY_BASE_DELAY_SECONDS=30
WFPM_TIMER_RETRY_MAX_DELAY_SECONDS=900
WFPM_TIMER_DISPATCH_BATCH_SIZE=50
