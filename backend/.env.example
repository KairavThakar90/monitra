# Monitra backend — environment variables.
#
# PLACEHOLDERS ONLY. Copy to `.env` for local development, or set these as
# platform environment variables in production (Vercel: Project → Settings →
# Environment Variables). Never commit a real value from this file.
#
# Only the transactional-email settings are documented here; the database,
# authentication-provider and Google Drive settings this backend also reads are
# described in backend/VERCEL_DEPLOYMENT.md and app/core/config.py.

# ─────────────────────────────────────────────────────────────────────────
# Transactional email — transport
# ─────────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER selects how mail leaves the system:
#   smtp      a real mail server, configured below. Use this in production.
#   console   logs the envelope instead of sending. Local development only.
#   disabled  queue but never deliver; rows stay pending.
# Anything unrecognised is treated as `disabled` rather than guessed at.
EMAIL_PROVIDER=smtp

# The envelope sender. Required — with it unset, nothing is delivered and every
# notification stays queued. Use an address on a domain whose SPF/DKIM/DMARC
# records authorise your provider, or the mail will be filed as spam.
EMAIL_FROM_ADDRESS=monitra@example.com
EMAIL_FROM_NAME=Monitra
# Optional. Where a human reply should go; omitted from the message when empty.
EMAIL_REPLY_TO=

# SMTP. Every transactional provider (Amazon SES, SendGrid, Postmark, Mailgun,
# Brevo, Resend, Google Workspace) offers an SMTP endpoint, so no provider SDK
# is needed — point these at whichever you use.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on the submission port (587). Leave true.
SMTP_USE_TLS=true
# Implicit TLS (SMTPS, port 465). Set this instead of SMTP_USE_TLS if your
# provider requires it; do not set both.
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# ─────────────────────────────────────────────────────────────────────────
# Feedback notifications — recipients
# ─────────────────────────────────────────────────────────────────────────
# Who is told when somebody submits feedback from the Monitra desktop client.
# No address is hard-coded anywhere in the source. With none of these set,
# feedback is still saved and simply nobody is notified — the /health endpoint
# reports that state so it is noticeable.
FEEDBACK_ADMIN_EMAIL=admin@example.com
FEEDBACK_HR_EMAIL=hr@example.com
# Optional. Comma-separated, for any further recipients. Merged with the two
# above and de-duplicated, so the same address twice still receives one email.
FEEDBACK_NOTIFICATION_EMAILS=

# ─────────────────────────────────────────────────────────────────────────
# Welcome email
# ─────────────────────────────────────────────────────────────────────────
# Sent once, when a Monitra account is first provisioned. Turning this off
# stops new welcomes being queued; it does not affect the once-per-user
# guarantee, which is a unique constraint in the database.
WELCOME_EMAIL_ENABLED=true
# The welcome email's "Open Monitra" button. Rendered ONLY when this is a real
# https:// URL — an http:// or localhost value is ignored rather than mailed
# out as a broken button. Leave empty to send the email without a button.
MONITRA_APP_URL=
# Optional. Shown as "need a hand? write to ..." in both emails.
MONITRA_SUPPORT_EMAIL=

# ─────────────────────────────────────────────────────────────────────────
# Delivery mechanics
# ─────────────────────────────────────────────────────────────────────────
# Attempts before a notification is parked as failed, and the retry backoff
# (exponential, jittered, capped). Six attempts span roughly six hours.
EMAIL_MAX_ATTEMPTS=6
EMAIL_RETRY_BASE_DELAY_SECONDS=60
EMAIL_RETRY_MAX_DELAY_SECONDS=3600
EMAIL_DISPATCH_BATCH_SIZE=20

# REQUIRED IN PRODUCTION. The shared secret for POST /internal/email/dispatch,
# which is the scheduled job that drains the outbox and retries failures. With
# this unset the endpoint answers 503, and the only delivery attempt a
# notification ever gets is the best-effort one inside the originating request
# — which a serverless platform may freeze before it runs.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
EMAIL_DISPATCH_TOKEN=

# Optional. A public https:// prefix the email templates load their logos from;
# this backend serves them at /email-assets. Left empty (the default), the
# logos are attached to each message and referenced by Content-ID instead,
# which needs no hosting and renders even when the client blocks remote images.
# Never point this at localhost — the recipient's mail client resolves it, not
# this server, and a localhost value is refused at render time.
EMAIL_ASSET_BASE_URL=
