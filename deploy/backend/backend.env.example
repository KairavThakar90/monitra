# Production environment for the Monitra backend.
# Lives at /etc/monitra/backend.env on the backend VM (root:monitra, mode 640).
# Loaded by systemd (EnvironmentFile=) -- values here are real environment
# variables, so they take precedence over any .env file in the source tree.

ENV=production

# Cloud SQL (PostgreSQL). The VM's external IP must be in the instance's
# authorized networks, or this connection times out.
DATABASE_URL=postgresql://USER:PASSWORD@35.200.162.243:5432/DBNAME?sslmode=require

# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME

EXTERNAL_AUTH_BASE_URL=https://nothing.peakworkos.com
EXTERNAL_AUTH_LOGIN_PATH=/wp-json/st-performance/v1/auth/hubstaff/login
EXTERNAL_AUTH_CONNECT_TIMEOUT=10.0
EXTERNAL_AUTH_READ_TIMEOUT=20.0

# Screenshot storage (Google Drive). Leave both unset to run with screenshot
# upload disabled (the API answers 503 for uploads; nothing else is affected).
# The key file must be readable by the `monitra` user.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/etc/monitra/google-service-account.json
