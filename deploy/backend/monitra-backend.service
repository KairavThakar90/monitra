[Unit]
Description=Monitra backend (FastAPI via Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monitra
Group=monitra
WorkingDirectory=/opt/monitra/backend
EnvironmentFile=/etc/monitra/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/monitra/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
